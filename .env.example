# ---- Staff editor (GitHub review mode) -------------------------------------------------------
# Repository that content Pull Requests are opened against. Defaults match the prototype repo.
VITE_GITHUB_OWNER=smagara
VITE_GITHUB_REPO=SlowDoughPizzaSite_Tina
VITE_GITHUB_BASE_BRANCH=main
# Feature branches are created as <prefix>/<github-login>/<timestamp>
VITE_CMS_BRANCH_PREFIX=cms
# auto (default): local Tina in `npm run dev`, GitHub everywhere else. Force with "local" or "github".
VITE_CMS_MODE=auto
VITE_TINA_LOCAL_URL=http://localhost:4001/graphql
# Minutes without activity before a GitHub editing session locks (0 = never). Default 30.
VITE_CMS_IDLE_LOCK_MINUTES=30

# ---- Optional: TinaCloud (only if you adopt the hosted Tina admin later) ---------------------
# TINA_CLIENT_ID=
# TINA_TOKEN=
# GITHUB_BRANCH=main

# ---- Build ----------------------------------------------------------------------------------
# Set by the GitHub Pages workflow to "/<repo-name>/"; leave unset for local development.
# BASE_PATH=/SlowDoughPizzaSite_Tina/
